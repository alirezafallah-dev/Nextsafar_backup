    // =====================================================================
    // ۶. اتصال به Payment (placeholder برای فاز بعدی)
    // =====================================================================

    /**
     * شروع فرآیند پرداخت
     * TODO: در فاز بعدی (Payment Module) به درگاه متصل می‌شود
     */
    public function initiatePayment(Order $order): array
    {
        if (!$order->canTransitionTo(Order::STATUS_PENDING_PAYMENT)) {
            throw new ApiException(
                errorCode: ApiErrorCode::VALIDATION_FAILED,
                userMessage: 'این سفارش در وضعیت قابل پرداخت نیست.',
                httpStatus: 422,
            );
        }

        if ($order->total_amount <= 0) {
            throw new ApiException(
                errorCode: ApiErrorCode::VALIDATION_FAILED,
                userMessage: 'مبلغ سفارش باید بیشتر از صفر باشد.',
                httpStatus: 422,
            );
        }

        // تغییر وضعیت به در انتظار پرداخت
        $this->changeStatus(
            $order,
            Order::STATUS_PENDING_PAYMENT,
            'آماده پرداخت',
            auth()->user(),
            'system'
        );

        // TODO: در فاز بعدی اینجا Payment record ساخته می‌شود و لینک درگاه برگردانده می‌شود
        return [
            'order_id' => $order->id,
            'order_code' => $order->code,
            'amount' => $order->total_amount,
            'payment_url' => null, // placeholder
            'message' => 'سفارش آماده پرداخت است. ماژول درگاه در فاز بعدی فعال می‌شود.',
        ];
    }

    // =====================================================================
    // ۷. Private Helpers
    // =====================================================================

    /**
     * مپ کردن نوع Lead به نوع Order
     */
    private function mapLeadTypeToOrderType(string $leadType): string
    {
        return match ($leadType) {
            Lead::TYPE_TOUR => Order::TYPE_TOUR,
            Lead::TYPE_HOTEL => Order::TYPE_HOTEL,
            Lead::TYPE_VISA => Order::TYPE_VISA,
            default => Order::TYPE_MIXED,
        };
    }

    /**
     * نرمال‌سازی کد ملی
     */
    private function normalizeNationalId(string $id): string
    {
        // حذف فاصله‌ها و خط‌ها
        $id = preg_replace('/[^0-9]/', '', $id);
        // پر کردن با صفر در ابتدا اگر کمتر از ۱۰ رقم
        return str_pad($id, 10, '0', STR_PAD_LEFT);
    }
}
